<Window x:Class="FlatPatternExporter.UI.Windows.AnnouncementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:FlatPatternExporter.UI.Controls"
        xmlns:extensions="clr-namespace:FlatPatternExporter.Extensions"
        shell:WindowChrome.WindowChrome="{StaticResource CustomWindowChrome}"
        Title="{extensions:Localize Announcement_Title}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="520"
        SizeToContent="Height"
        Background="{DynamicResource BackgroundPrimaryBrush}"
        Foreground="{DynamicResource TextSecondaryBrush}">

    <Window.Resources>
        <Style x:Key="AnnouncementSectionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowRootBorderStyle}">
        <Grid SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:CustomTitleBar Grid.Row="0"
                                  Title="{extensions:Localize Announcement_Title}"
                                  ShowMinimizeButton="False"
                                  ShowMaximizeButton="False"/>

            <StackPanel Grid.Row="1" Margin="{StaticResource StandardPaddingThickness}">
                <TextBlock x:Name="HeaderTextBlock"
                           Style="{StaticResource OverlayTitleTextStyle}"
                           HorizontalAlignment="Left"
                           Margin="0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="SubtitleTextBlock"
                           Style="{StaticResource AnnouncementSectionTextStyle}"
                           Margin="{StaticResource TopSmallMarginThickness}"/>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{extensions:Localize Announcement_InterfaceTitle}"/>
                <TextBlock Style="{StaticResource AnnouncementSectionTextStyle}" Text="{extensions:Localize Announcement_InterfaceText}"/>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{extensions:Localize Announcement_InstallationTitle}"/>
                <TextBlock Style="{StaticResource AnnouncementSectionTextStyle}" Text="{extensions:Localize Announcement_InstallationText}"/>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{extensions:Localize Announcement_UpdatesTitle}"/>
                <TextBlock Style="{StaticResource AnnouncementSectionTextStyle}" Text="{extensions:Localize Announcement_UpdatesText}"/>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{extensions:Localize Announcement_RuntimeTitle}"/>
                <TextBlock Style="{StaticResource AnnouncementSectionTextStyle}" Text="{extensions:Localize Announcement_RuntimeText}"/>

                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{extensions:Localize Announcement_MigrationTitle}"/>
                <TextBlock Style="{StaticResource AnnouncementSectionTextStyle}" Text="{extensions:Localize Announcement_MigrationText}"/>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource DialogBottomBarStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenPageButton"
                            Style="{StaticResource FileNameActionButtonStyle}"
                            Click="OpenPageButton_Click"
                            Margin="{StaticResource RightSmallMarginThickness}"/>
                    <Button Content="{extensions:Localize Button_Close}"
                            Style="{StaticResource FileNameActionButtonStyle}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
